# Sample Environment File

# Twelve Data API Key
TWELVEDATA_API_KEY=REPLACE_WITH_YOUR_TWELVEDATA_KEY

# Finnhub API Keys (for real-time data)
FINNHUB_API_KEY_1=REPLACE_WITH_YOUR_FINNHUB_API_KEY_1
FINNHUB_API_KEY_2=REPLACE_WITH_YOUR_FINNHUB_API_KEY_2
FINNHUB_API_KEY_3=REPLACE_WITH_YOUR_FINNHUB_API_KEY_3
FINNHUB_API_KEY_4=REPLACE_WITH_YOUR_FINNHUB_API_KEY_4

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID

# Trading Configuration
INITIAL_BALANCE=10000
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.20

# Logging Level
LOG_LEVEL=INFO

# Database Path (SQLite for simplicity)
DATABASE_PATH=historical_data.db